API_ID=
API_HASH=
BOT_TOKEN=
ALLOWED_USER_IDS=
STORAGE_DIR=/storage
BATCH_TIMEOUT=30
# Telegram ID of the bot's owner: receives messages the bot could not
# process and can mark them as fixed. Telegram doesn't tell a bot who owns it.
OWNER_USER_ID=

# --- Group archive (optional) ---
# Path to this env file: the bot re-reads it on change and applies the
# archive settings below (ARCHIVE_CHATS, ARCHIVE_TZ, ELEVENLABS_API_KEY,
# STT_MODEL, TRANSCRIBE_MAX_SECONDS) without a restart. Empty = no hot reload.
CONFIG_FILE=
# The bot, added to a group with privacy mode off (BotFather /setprivacy ->
# Disable), silently records every message there into a markdown archive.
# <chat_id>[/<topic_id>]=<archive dir>, several separated by ";"; with
# /<topic_id> only that forum topic is archived. Empty = archive off.
# History is read on start (by message id) from where the last scan stopped.
ARCHIVE_CHATS=
# Time zone for day files and times in the archive (default Europe/Berlin)
ARCHIVE_TZ=Europe/Berlin
# MTProto session dir: persistent session = catch up on messages sent while
# the bot was down (default ./sessions)
ARCHIVE_SESSION_DIR=sessions
# ElevenLabs API key (Speech to Text permission) for voice/audio/video
# transcripts; empty = files only, no transcripts
ELEVENLABS_API_KEY=
# ElevenLabs Scribe model (default scribe_v2); /v1/models doesn't list STT
# models, so a newer one is set here by hand
STT_MODEL=scribe_v2
# Don't transcribe media longer than this (seconds, default 1800)
TRANSCRIBE_MAX_SECONDS=1800
